# ---- WEBドック 環境変数(本番は .env にコピーして設定)----

# 待ち受けポート(nginxから127.0.0.1:PORTへプロキシ。dialer=3002/omiseni=3000番台と重複しない値)
PORT=3020

# サービス表示名・運営社名
SERVICE_NAME=WEBドック
OPERATOR_NAME=株式会社エストック

# カルテ閲覧URLの署名鍵。必ずランダムな長い文字列に変更すること
# 生成例: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBDOCK_SECRET=change-me-to-a-long-random-string

# 営業・商談版(/sales)の合言葉。営業だけに共有。本番は必ず変更すること
SALES_PIN=change-me-sales-pin

# ---- データベース(MySQL)。未設定なら ./data/ にファイル保存(開発用)----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=webdock
DB_USER=webdock_user
DB_PASS=

# ---- Cloudflare Turnstile(ボット対策)。未設定なら検証スキップ(開発用)----
TURNSTILE_SITEKEY=
TURNSTILE_SECRET=

# ---- 地域による対応会社の振り分け ----
# 振り分け(TOCはUTM、STOCはWEB): 兵庫・岡山=STOCが訪問(UTM・PC PATROL中心) / 大阪=TOC(UTM) / それ以外=STOC(全国・オンライン)
STOC_VISIT_PREFECTURES=兵庫県,岡山県
TOC_PREFECTURES=大阪府
# カルテ・通知に表示する問い合わせ電話番号(会社別。未設定なら共通番号)
TOC_TEL=0120-830-046
STOC_TEL=0120-830-046

# ---- 申込通知メール(SMTP)。未設定ならログ出力のみ ----
# 対応会社別の通知先。未設定時は LEAD_NOTIFY_TO にフォールバック
LEAD_NOTIFY_TO=kit@stoc.co.jp
TOC_NOTIFY_TO=
STOC_NOTIFY_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=alert@stoc-plus.site

# ---- 倉庫の管理画面(/admin/warehouse)。次の2つが両方設定されたときだけ有効(どちらかが空なら /admin は404)----
WAREHOUSE_ADMIN_PASS=
# 会社のグローバルIP(カンマ区切り)。このIP以外からは 404
ADMIN_ALLOW_IPS=
# アップロード置き場・CSV出力先(省略可)
WAREHOUSE_UPLOAD_DIR=/var/data/gmp/uploads
WAREHOUSE_EXPORT_DIR=
