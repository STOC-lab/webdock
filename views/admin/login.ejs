<%- include('_head') %>
<section class="adm-card adm-narrow">
  <h1>ログイン</h1>
  <p class="adm-help">合言葉を入力してください。</p>
  <form method="post" action="<%= BASE %>/login">
    <input class="adm-input" name="password" type="password" autocomplete="current-password" placeholder="合言葉" required autofocus>
    <button class="adm-btn" type="submit">入室する</button>
  </form>
</section>
