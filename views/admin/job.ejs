<%- include('_head') %>
<section class="adm-card" id="job" data-url="<%= BASE %>/jobs/<%= job.id %>/json" data-running="<%= job.status === 'running' ? '1' : '' %>">
  <h1>#<%= job.id %> <%= job.title %></h1>
  <p>状態: <span class="adm-badge adm-<%= job.status %>" id="status"><%= job.status === 'running' ? '実行中…' : job.status === 'success' ? '成功' : '失敗' %></span>
    <span class="adm-help" id="times">開始 <%= fmtTime(job.startedAt) %><%= job.endedAt ? ' ／ 終了 ' + fmtTime(job.endedAt) : '' %></span></p>
  <div id="dl"><% if (job.downloadUrl) { %>
    <a class="adm-btn adm-link" href="<%= job.downloadUrl %>">CSVをダウンロード(<%= job.exportFile %>)</a>
    <div class="adm-warn">出した店には「出力済み」の印が付いています。ダウンロードしてから画面を離れてください。</div>
  <% } %></div>
  <% if (typeof singleView !== 'undefined' && singleView) { %>
  <h3>送信用ファイル(全社共通の本文・1つの宛先CSV)</h3>
  <% if (singleView.dryRun) { %><div class="adm-warn">STOC未登録(試し)です。バッチコードは仮で、このまま送信しても結果はSTOCへ戻りません。</div>
  <% } else { %><div class="adm-help">STOC営業管理に登録したバッチコード(送信結果はこのコードでSTOCへ戻ります):</div>
  <% } %>
  <ul class="adm-list"><% singleView.batches.forEach(function (b) { %>
    <li><strong><%= b.code %></strong>(<%= b.count %>社) ・ <a href="<%= b.url %>">送信ツール用CSV(<%= b.file %>)</a></li>
  <% }) %></ul>
  <p><% if (singleView.check) { %><a href="<%= singleView.check.url %>">確認用.csv</a><% } %>
    <% if (singleView.summary) { %> ・ <a href="<%= singleView.summary.url %>">まとめ.txt</a><% } %>
    <% if (singleView.body) { %> ・ <a href="<%= singleView.body.url %>">本文.txt</a><% } %></p>
  <% if (singleView.summary) { %><textarea class="adm-input" readonly rows="<%= Math.min(24, singleView.summary.text.split('\n').length + 1) %>" style="width:100%"><%= singleView.summary.text %></textarea><% } %>
  <% if (singleView.body) { %>
  <p class="adm-help">本文(送信ツールの本文欄にそのまま貼り付け。[company] [name] [param1] [param2] は送信ツールが差し込みます)</p>
  <textarea class="adm-input" id="singlebody" readonly rows="18" style="width:100%"><%= singleView.body.text %></textarea>
  <p><button type="button" class="adm-mini copybtn" data-target="singlebody">コピー</button> <span class="adm-help copied" data-for="singlebody"></span></p>
  <script>
  (function () {
    Array.prototype.forEach.call(document.querySelectorAll('.copybtn'), function (b) {
      b.addEventListener('click', function () {
        var ta = document.getElementById(b.dataset.target);
        var msg = document.querySelector('.copied[data-for="' + b.dataset.target + '"]');
        function done(t) { if (msg) msg.textContent = t; }
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(ta.value).then(function () { done('コピーしました'); }, function () { ta.select(); done('選択しました。Ctrl+Cでコピーしてください'); });
        } else { ta.select(); done('選択しました。Ctrl+Cでコピーしてください'); }
      });
    });
  })();
  </script>
  <% } %>
  <% } %>
  <% if (typeof groupView !== 'undefined' && groupView) { %>
  <h3>送信グループ(指摘ごと・1グループ=1回の送信)</h3>
  <div class="adm-warn">送信ツールは全社同じ本文しか送れないため、指摘ごとにグループに分けています。本文はグループごとに違います。最初の100社は送る前に人が確認してください。</div>
  <% if (groupView.summary) { %><p><a href="<%= groupView.summary.url %>">まとめ.txt をダウンロード</a></p>
  <textarea class="adm-input" readonly rows="<%= Math.min(14, groupView.summary.text.split('\n').length + 1) %>" style="width:100%"><%= groupView.summary.text %></textarea><% } %>
  <% groupView.groups.forEach(function (g, i) { %>
  <div class="adm-sub" style="margin-top:1.2em">
    <h3><%= g.key %>(<%= g.count %>社)</h3>
    <p><a href="<%= g.csv.url %>">送信ツール用CSV(<%= g.csv.name %>)</a>
      <% if (g.check) { %> ・ <a href="<%= g.check.url %>">確認用CSV(<%= g.check.name %>)</a><% } %>
      <% if (g.subject) { %> ・ <a href="<%= g.subject.url %>">件名候補</a><% } %>
      <% if (g.body) { %> ・ <a href="<%= g.body.url %>">標準本文.txt</a><% } %>
      <% if (g.short) { %> ・ <a href="<%= g.short.url %>">短縮本文.txt</a><% } %></p>
    <% if (g.subject) { %><p class="adm-help">件名の候補:</p><pre class="adm-log"><%= g.subject.text %></pre><% } %>
    <% [['標準本文', g.body], ['短縮本文', g.short]].forEach(function (b, j) { if (!b[1]) return; var id = 'ta' + i + '_' + j; %>
    <p class="adm-help"><%= b[0] %>(<%= [...b[1].text].length %>文字)</p>
    <textarea class="adm-input" id="<%= id %>" readonly rows="14" style="width:100%"><%= b[1].text %></textarea>
    <p><button type="button" class="adm-mini copybtn" data-target="<%= id %>">コピー</button> <span class="adm-help copied" data-for="<%= id %>"></span></p>
    <% }) %>
  </div>
  <% }) %>
  <script>
  (function () {
    Array.prototype.forEach.call(document.querySelectorAll('.copybtn'), function (b) {
      b.addEventListener('click', function () {
        var ta = document.getElementById(b.dataset.target);
        var msg = document.querySelector('.copied[data-for="' + b.dataset.target + '"]');
        function done(t) { if (msg) msg.textContent = t; }
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(ta.value).then(function () { done('コピーしました'); }, function () { ta.select(); done('選択しました。Ctrl+Cでコピーしてください'); });
        } else { ta.select(); done('選択しました。Ctrl+Cでコピーしてください'); }
      });
    });
  })();
  </script>
  <% } %>
  <h3>実行のようす(最新500行)</h3>
  <pre class="adm-log" id="log"><%= job.log.join('\n') %></pre>
  <p><a href="<%= BASE %>/">状況へ戻る</a></p>
</section>
<script>
(function () {
  var box = document.getElementById('job');
  if (!box.dataset.running) return;
  var names = { running: '実行中…', success: '成功', failed: '失敗' };
  function fmt(ms) { return ms ? new Date(ms).toLocaleString('ja-JP') : ''; }
  function tick() {
    fetch(box.dataset.url, { credentials: 'same-origin' }).then(function (r) { return r.json(); }).then(function (j) {
      var log = document.getElementById('log');
      log.textContent = j.log.join('\n');
      log.scrollTop = log.scrollHeight;
      var st = document.getElementById('status');
      st.textContent = names[j.status] || j.status;
      st.className = 'adm-badge adm-' + j.status;
      document.getElementById('times').textContent = '開始 ' + fmt(j.startedAt) + (j.endedAt ? ' ／ 終了 ' + fmt(j.endedAt) : '');
      if (j.status === 'running') { setTimeout(tick, 2000); return; }
      if (j.groupDir || j.singleDir) { location.reload(); return; }
      if (j.downloadUrl) {
        var dl = document.getElementById('dl');
        dl.textContent = '';
        var a = document.createElement('a');
        a.className = 'adm-btn adm-link'; a.href = j.downloadUrl; a.textContent = 'CSVをダウンロード(' + j.exportFile + ')';
        var w = document.createElement('div');
        w.className = 'adm-warn'; w.textContent = '出した店には「出力済み」の印が付いています。ダウンロードしてから画面を離れてください。';
        dl.appendChild(a); dl.appendChild(w);
      }
    }).catch(function () { setTimeout(tick, 4000); });
  }
  setTimeout(tick, 2000);
})();
</script>
<%- include('_foot') %>
