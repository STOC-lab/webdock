<%- include('partials/head', { pageTitle: '営業モード ― ' + SERVICE_NAME }) %>
<section class="hero sales-hero">
  <span class="sales-badge">営業モード</span>
  <h1>WEBドック 商談ツール</h1>
  <p class="lead">合言葉を入力してください。</p>
  <% if (error) { %><div class="alert"><%= error %></div><% } %>
  <form class="scan-form" method="post" action="/sales/login">
    <input name="pin" type="password" autocomplete="off" placeholder="合言葉" required autofocus>
    <button type="submit">入室する</button>
  </form>
</section>
<%- include('partials/foot') %>
